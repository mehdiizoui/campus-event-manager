<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start">
  <div>
    <h1 class="mb-1"><%= event.title %></h1>
    <div class="text-muted"><span class="badge bg-secondary"><%= event.category %></span>
      <% (event.tags || []).forEach(function(t) { %><span class="badge badge-tag"><%= t %></span><% }) %>
    </div>
  </div>
  <div>
    <a href="/events/<%= event._id %>/edit" class="btn btn-outline-secondary">Éditer</a>
    <form method="post" action="/events/<%= event._id %>?_method=DELETE" class="d-inline"
          onsubmit="return confirm('Supprimer cet event ?')">
      <button class="btn btn-outline-danger">Supprimer</button>
    </form>
  </div>
</div>

<div class="row g-3 mt-2">
  <div class="col-md-8">
    <div class="card p-3">
      <p><%= event.description %></p>
      <div class="row small">
        <div class="col-md-6"><strong>Début :</strong> <%= event.startDate.toLocaleString('fr-FR') %></div>
        <div class="col-md-6"><strong>Fin :</strong> <%= event.endDate.toLocaleString('fr-FR') %></div>
        <div class="col-md-6 mt-2"><strong>Lieu :</strong> <%= event.location.building %>, salle <%= event.location.room %> (<%= event.location.campus %>)</div>
        <div class="col-md-6 mt-2"><strong>Organisateur :</strong>
          <% if (organizer) { %><a href="/users/<%= organizer._id %>"><%= organizer.firstName %> <%= organizer.lastName %></a><% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card p-3">
      <div class="d-flex justify-content-between">
        <div><strong>Capacité</strong></div><div><%= event.capacity %></div>
      </div>
      <div class="d-flex justify-content-between">
        <div><strong>Confirmées</strong></div><div><%= confirmed %></div>
      </div>
      <div class="progress mt-2"><div class="progress-bar bg-<%= occupancy >= 100 ? 'danger' : 'success' %>" style="width: <%= Math.min(occupancy, 100) %>%"></div></div>
      <div class="text-muted small mt-1"><%= occupancy %>% occupé</div>
      <% if (confirmed >= event.capacity) { %>
        <div class="alert alert-danger mt-2 py-2 small mb-0">Event complet</div>
      <% } %>
    </div>
  </div>
</div>

<h4 class="section-title mt-4">Ajouter un participant</h4>
<form method="post" action="/events/<%= event._id %>/registrations" class="row g-2 bg-white p-3 rounded shadow-sm">
  <div class="col-md-8">
    <select name="userId" class="form-select" required>
      <option value="">— sélectionner un utilisateur —</option>
      <% allUsers.forEach(function(u) { %>
        <option value="<%= u._id %>"><%= u.firstName %> <%= u.lastName %> (<%= u.email %>)</option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-4"><button class="btn btn-primary w-100">Inscrire</button></div>
</form>

<h4 class="section-title mt-4">Participants</h4>
<table class="table bg-white">
  <thead><tr><th>Nom</th><th>Email</th><th>Statut</th><th>Inscrit le</th><th></th></tr></thead>
  <tbody>
    <% event.registrations.forEach(function(r) { const u = usersById[r.userId.toString()]; %>
      <tr>
        <td><% if (u) { %><a href="/users/<%= u._id %>"><%= u.firstName %> <%= u.lastName %></a><% } else { %>—<% } %></td>
        <td><%= u ? u.email : '—' %></td>
        <td>
          <% if (r.status === 'confirmed') { %><span class="badge bg-success">confirmed</span>
          <% } else if (r.status === 'waiting') { %><span class="badge bg-warning text-dark">waiting</span>
          <% } else { %><span class="badge bg-secondary">cancelled</span><% } %>
        </td>
        <td class="small text-muted"><%= r.registeredAt.toLocaleString('fr-FR') %></td>
        <td class="text-end">
          <% if (r.status !== 'cancelled') { %>
            <form method="post" action="/events/<%= event._id %>/registrations/<%= r.userId %>/cancel" class="d-inline">
              <button class="btn btn-sm btn-outline-warning">Annuler</button>
            </form>
          <% } %>
          <form method="post" action="/events/<%= event._id %>/registrations/<%= r.userId %>?_method=DELETE" class="d-inline"
                onsubmit="return confirm('Retirer cet utilisateur ?')">
            <button class="btn btn-sm btn-outline-danger">Retirer</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (event.registrations.length === 0) { %>
      <tr><td colspan="5" class="text-muted text-center py-3">Aucun participant.</td></tr>
    <% } %>
  </tbody>
</table>

<a href="/events" class="btn btn-outline-secondary">← Retour</a>
<%- include('../partials/footer') %>
